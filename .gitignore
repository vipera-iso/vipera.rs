# This repository is the engine workspace and its specifications.
# Everything else in this home directory belongs to other projects and is not part of it.
/*
!/.gitignore
!/.github/
!/Cargo.toml
!/Cargo.lock
!/rust-toolchain.toml
!/README.md
!/CONTRIBUTING.md
!/LICENSE-MIT
!/LICENSE-APACHE
!/crates/
!/bins/
!/scripts/
# Only the engine's own script is part of the repository; this home directory has others.
/scripts/*
!/scripts/parity-tokenize.sh
!/specs/
# Design notes for the engine itself live beside the specs. Only this directory is part of the
# repository; the other trees under docs/ (benchmark output, graph dumps, scratch notes) are not.
!/docs/
/docs/*
!/docs/design/
/docs/design/*
!/docs/design/*.md

# Build output is large and reproducible.
/target/
