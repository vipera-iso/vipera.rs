# Defaults match what `cargo fmt` already produces, so an editor that honours this file does not
# fight the gate. Rust is formatted by rustfmt; these rules apply to everything else.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json}]
indent_size = 2
trim_trailing_whitespace = false

[*.{toml,sh}]
indent_size = 2

[Makefile]
indent_style = tab
